<%- include('../includes/header.ejs') %>

<%- include('../includes/navbar.ejs') %>
    <body>
        <main>
            <% if(products.length > 0) { %>
                <ul>
                    <% products.forEach((prodData) => { %>
                        <li>
                            <%= prodData.title %> - (<%= prodData.cartItems.quantity %>)
                        </li>
                        <% }); %>
                    </ul>
                    <form method="POST" action="/cart-delete-product">
                        <input type="hidden" value="<%= prodData.id %>" name="productId" />
                        <button type="submit" class="btn">Delete</button>
                    </form>
                <% } else { %>
                    <h1>No Products found in the Cart.</h1>
            <% } %>
        </main>
        
<%- include('../includes/footer.ejs') %>