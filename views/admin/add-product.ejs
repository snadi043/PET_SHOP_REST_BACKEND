<%- include('../includes/header.ejs') %>

    <link rel="stylesheet" href="/css/form.css"/>
    <link rel="stylesheet" href="/css/product.css"/>

<%- include('../includes/navbar.ejs') %>

<body>
    <form class="product-form" type="submit" method="POST" action="/admin/add-products">
        <div class="form-control">
            <label class="form-control" for="prod_title" id="prod_title">Title</label>
            <input type="text" name="prod_title" required/>
        </div>
        <div class="form-control">
            <label class="form-control" for="prod_imageUrl" id="prod_imageUrl">Image Url</label>
            <input type="text" name="prod_imageUrl" required/>
        </div>
        <div class="form-control">
            <label class="form-control" for="prod_price" id="prod_price">Price</label>
            <input type="number" name="prod_price" required/>
        </div>
        <div class="form-control">
            <label class="form-control" for="prod_description" id="prod_description">Description</label>
            <input type="textarea" name="prod_description" required/>
        </div>
        <button class="btn" type="submit">Add Product</button>
    </form>

<%- include('../includes/footer.ejs') %>