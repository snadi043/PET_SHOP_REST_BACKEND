<%- include('../includes/header.ejs') %>

    <link rel="stylesheet" href="/css/form.css"/>
    <link rel="stylesheet" href="/css/product.css"/>

<%- include('../includes/navbar.ejs') %>

<body>
    <form class="product-form" type="submit" method="POST" action="/admin/<% if(editing) {%> edit-product <%} else { %> add-product<%}%>">
        <div class="form-control">
            <label class="form-control" for="prod_title" id="prod_title">Title</label>
            <input type="text" name="prod_title" value="<% if(editing) { %><%= product.title %> <%}%>" required/>
        </div>
        <div class="form-control">
            <label class="form-control" for="prod_imageUrl" id="prod_imageUrl">Image Url</label>
            <input type="text" name="prod_imageUrl" value="<% if(editing) { %><%= product.imageUrl %> <%}%>" required/>
        </div>
        <div class="form-control">
            <label class="form-control" for="prod_price" id="prod_price">Price</label>
            <input type="number" name="prod_price" value="<% if(editing) { %><%= product.price %> <%}%>" step="0.01" required/>
        </div>
        <div class="form-control">
            <label class="form-control" for="prod_description" id="prod_description">Description</label>
            <textarea rows="5"  cols="15" name="prod_description"><% if(editing) { %><%= product.description %> <%}%></textarea>
        </div>
        <% if(editing) {%>
            <input type="hidden" value="<%= product.id %>" name="productId" />
        <%} %>
        <button class="btn" type="submit"><% if(editing) {%> Update Product <% } else { %> Add Product <%}%></button>
    </form>

<%- include('../includes/footer.ejs') %>
