<%- include('../includes/header.ejs') %>

<link rel="stylesheet" href="/css/form.css" />
<link rel="stylesheet" href="/css/signup.css">

<%- include('../includes/navbar.ejs') %>

<body>
    <% if(errorMessage) { %>
        <div class="centered">
            <h1><%= errorMessage %></h1>
        </div>
    <% } %>
    <form class="signup-form" method="POST" action="/signup" novalidate>
        <div class="form-control">
            <label for="email">Email</label>
            <input 
                class = "<% errorValidation.find(e => e.path === 'email') ? 'invalid' : '' %>"
                type="email" 
                name="email" 
                id="email" 
                value="<%= userEnteredValues.email %>"
                required/>
        </div>
        <div class="form-control">
            <label for="password">Password</label>
            <input 
                class="<% errorValidation.find(e => e.path === 'password') ? 'invalid' : '' %>"
                type="password" 
                name="password" 
                id="password" 
                value="<%= userEnteredValues.password %>"
                required/>
        </div>
        <div class="form-control">
            <label for="cpassword">Confirm Password</label>
            <input
                class="<% errorValidation.find(e => e.path === 'cpassword') ? 'invalid' : '' %>"
                type="password" 
                name="cpassword" 
                id="cpassword" 
                value="<%= userEnteredValues.cpassword %>"
                required/>
        </div>
        <div class="centered">
            <button type="submit" class="btn">Signup</button>
        </div>
    </form>

<%- include('../includes/footer.ejs') %>